{
  "name": "northstar-support-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs && playwright test",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "demo": "playwright test tests/bulk-assign.spec.ts --headed --trace on",
    "report": "playwright show-report --host 127.0.0.1",
    "bug:on": "node scripts/regression.mjs on",
    "bug:off": "node scripts/regression.mjs off"
  },
  "devDependencies": { "@playwright/test": "1.63.0" }
}
